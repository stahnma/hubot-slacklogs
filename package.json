{
  "name": "hubot-slacklogs",
  "version": "0.0.4",
  "description": "Log what's happening in slack in jsonl format",
  "main": "index.js",
  "homepage": "https://github.com/stahnma/hubot-slacklogs",
  "scripts": {
    "test": "EXPRESS_PORT=9012 mocha  --extension mjs --verbose --exit \"test/**/*.*\" --reporter spec",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stahnma/hubot-slacklogs"
  },
  "keywords": [
    "hubot",
    "slack",
    "logs"
  ],
  "author": "stahnma",
  "license": "MIT",
  "dependencies": {
    "@slack/web-api": "^7.9.1"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "eslint": "^8.57.0",
    "@eslint/js": "^9.0.0"
  }
}
